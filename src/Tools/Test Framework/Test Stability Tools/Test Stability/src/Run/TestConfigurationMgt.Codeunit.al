namespace System.TestTools.TestStability;

using System.TestTools.TestRunner;

codeunit 130483 "Test Configuration Mgt"
{
    Permissions = tabledata "AL Test Suite" = rimd,
                  tabledata "Test Method Line" = rimd,
                  tabledata "Test Configuration" = rimd;
    InherentEntitlements = X;
    InherentPermissions = X;

    var
        TestSuiteMgt: Codeunit "Test Suite Mgt.";
        GeneratedSourceErr: Label 'Test suite %1 was generated by stability mode and cannot generate more stability suites.', Comment = '%1 = suite name';
        NoConfigurationsErr: Label 'Test suite %1 has no enabled test configurations. Create or enable a configuration before generating stability suites.', Comment = '%1 = suite name';
        NoTestsErr: Label 'Test suite %1 contains no test codeunits.', Comment = '%1 = suite name';
        SuiteNumbersExhaustedErr: Label 'No more S-######## stability suite names are available.';

    /// <summary>
    /// Replaces all generated suites for the parent and returns their codes without running tests.
    /// </summary>
    procedure GenerateStabilitySuites(ParentSuiteName: Code[10]): List of [Code[10]]
    begin
        exit(GenerateStabilitySuites(ParentSuiteName, ''));
    end;

    /// <summary>
    /// Replaces the selected configuration's suite, or all generated suites when the code is blank.
    /// </summary>
    procedure GenerateStabilitySuites(ParentSuiteName: Code[10]; ConfigurationCode: Code[20]) GeneratedSuiteNames: List of [Code[10]]
    var
        ParentSuite: Record "AL Test Suite";
        GeneratedSuite: Record "AL Test Suite";
        TestConfiguration: Record "Test Configuration";
        SourceLine: Record "Test Method Line";
        LastSuiteName: Code[10];
    begin
        GetParentSuite(ParentSuiteName, ParentSuite);
        SourceLine.SetRange("Test Suite", ParentSuiteName);
        SourceLine.SetRange("Line Type", SourceLine."Line Type"::Codeunit);
        if SourceLine.IsEmpty() then
            Error(NoTestsErr, ParentSuiteName);

        TestConfiguration.SetCurrentKey("Test Suite", Enabled, Code);
        TestConfiguration.SetRange("Test Suite", ParentSuiteName);
        TestConfiguration.SetRange(Enabled, true);
        if ConfigurationCode <> '' then
            TestConfiguration.SetRange(Code, ConfigurationCode);
        if TestConfiguration.IsEmpty() then
            Error(NoConfigurationsErr, ParentSuiteName);

        LastSuiteName := GetLastGeneratedSuiteName();
        GeneratedSuite.SetRange("Created From Suite", ParentSuiteName);
        if ConfigurationCode <> '' then
            GeneratedSuite.SetRange(Configuration, ConfigurationCode);
        GeneratedSuite.DeleteAll(true);

        TestConfiguration.FindSet();
        repeat
            GeneratedSuiteNames.Add(GenerateSuite(ParentSuite, TestConfiguration, LastSuiteName));
        until TestConfiguration.Next() = 0;
    end;

    /// <summary>
    /// Regenerates and runs all enabled configurations through the ordinary test runner.
    /// </summary>
    procedure RunTestConfigurations(ParentSuiteName: Code[10])
    var
        GeneratedSuiteNames: List of [Code[10]];
        SuiteName: Code[10];
    begin
        GeneratedSuiteNames := GenerateStabilitySuites(ParentSuiteName);
        foreach SuiteName in GeneratedSuiteNames do
            RunSuite(SuiteName);
    end;

    procedure RunTestConfiguration(ParentSuiteName: Code[10]; ConfigurationCode: Code[20])
    var
        GeneratedSuiteNames: List of [Code[10]];
    begin
        GeneratedSuiteNames := GenerateStabilitySuites(ParentSuiteName, ConfigurationCode);
        RunSuite(GeneratedSuiteNames.Get(1));
    end;

    procedure RunSuite(SuiteName: Code[10])
    var
        TestMethodLine: Record "Test Method Line";
    begin
        TestMethodLine."Test Suite" := SuiteName;
        TestSuiteMgt.RunAllTests(TestMethodLine);
    end;

    procedure ResetStabilityMode(SuiteName: Code[10])
    var
        ALTestSuite: Record "AL Test Suite";
        TestConfigurationRunner: Codeunit "Test Configuration Runner";
        ALTestRunnerResetEnvironment: Codeunit "ALTestRunner Reset Environment";
    begin
        ALTestSuite.Get(SuiteName);
        TestConfigurationRunner.Reset();
        ALTestRunnerResetEnvironment.Initialize();
    end;

    /// <summary>
    /// Explicitly creates the starter configurations for an unconfigured parent.
    /// </summary>
    procedure EnsureDefaultConfigurations(ParentSuiteName: Code[10])
    var
        ParentSuite: Record "AL Test Suite";
        TestConfiguration: Record "Test Configuration";
    begin
        GetParentSuite(ParentSuiteName, ParentSuite);
        TestConfiguration.SetRange("Test Suite", ParentSuiteName);
        if not TestConfiguration.IsEmpty() then
            exit;

        AddConfiguration(ParentSuiteName, 'BASELINE', 'Runs the suite without any changes.', false, 0, '', false, false);
        AddConfiguration(ParentSuiteName, 'SEED1-WD1Y', 'Random seed 1 and WorkDate one year in the future.', true, 1, '<1Y>', false, false);
        AddConfiguration(ParentSuiteName, 'ONEBYONE', 'Runs each test method in its own codeunit block.', false, 0, '', true, false);
        AddConfiguration(ParentSuiteName, 'SEED2-WD2Y', 'Random seed 2 and WorkDate two years in the future.', true, 2, '<2Y>', false, false);
        AddConfiguration(ParentSuiteName, 'REVERSE', 'Runs codeunit blocks in reverse order.', false, 0, '', false, true);
    end;

    local procedure GetParentSuite(SuiteName: Code[10]; var ALTestSuite: Record "AL Test Suite")
    begin
        ALTestSuite.Get(SuiteName);
        if ALTestSuite."Created From Suite" <> '' then
            Error(GeneratedSourceErr, SuiteName);
    end;

    local procedure GenerateSuite(ParentSuite: Record "AL Test Suite"; TestConfiguration: Record "Test Configuration"; var LastSuiteName: Code[10]): Code[10]
    var
        GeneratedSuite: Record "AL Test Suite";
        SourceCodeunit: Record "Test Method Line";
        SourceMethod: Record "Test Method Line";
        NextLineNo: Integer;
    begin
        GeneratedSuite := ParentSuite;
        GeneratedSuite.Name := GetNextSuiteName(LastSuiteName);
        GeneratedSuite.Description := CopyStr(TestConfiguration.Description, 1, MaxStrLen(GeneratedSuite.Description));
        GeneratedSuite."Created From Suite" := ParentSuite.Name;
        GeneratedSuite.Configuration := TestConfiguration.Code;
        GeneratedSuite."Stability Run" := false;
        GeneratedSuite."Last Run" := 0DT;
        GeneratedSuite.Insert(true);

        SourceCodeunit.SetRange("Test Suite", ParentSuite.Name);
        SourceCodeunit.SetRange("Line Type", SourceCodeunit."Line Type"::Codeunit);
        SourceCodeunit.Ascending(not TestConfiguration."Reverse Order");
        if SourceCodeunit.FindSet() then
            repeat
                SourceMethod.SetRange("Test Suite", ParentSuite.Name);
                SourceMethod.SetRange("Line Type", SourceMethod."Line Type"::Function);
                SourceMethod.SetFilter("Line No.", TestSuiteMgt.GetLineNoFilterForTestCodeunit(SourceCodeunit));
                if not TestConfiguration."One By One" or SourceMethod.IsEmpty() then
                    CopyLine(SourceCodeunit, GeneratedSuite.Name, NextLineNo);
                if SourceMethod.FindSet() then
                    repeat
                        if TestConfiguration."One By One" then
                            CopyLine(SourceCodeunit, GeneratedSuite.Name, NextLineNo);
                        CopyLine(SourceMethod, GeneratedSuite.Name, NextLineNo);
                    until SourceMethod.Next() = 0;
            until SourceCodeunit.Next() = 0;

        exit(GeneratedSuite.Name);
    end;

    local procedure CopyLine(SourceLine: Record "Test Method Line"; SuiteName: Code[10]; var NextLineNo: Integer)
    var
        GeneratedLine: Record "Test Method Line";
    begin
        NextLineNo += 1000;
        GeneratedLine := SourceLine;
        GeneratedLine."Test Suite" := SuiteName;
        GeneratedLine."Line No." := NextLineNo;
        GeneratedLine.Result := GeneratedLine.Result::" ";
        TestSuiteMgt.ClearErrorOnLine(GeneratedLine);
        GeneratedLine."Start Time" := 0DT;
        GeneratedLine."Finish Time" := 0DT;
        GeneratedLine.Insert();
    end;

    local procedure GetLastGeneratedSuiteName(): Code[10]
    var
        ALTestSuite: Record "AL Test Suite";
    begin
        ALTestSuite.SetRange(Name, 'S-00000000', 'S-99999999');
        ALTestSuite.Ascending(false);
        if ALTestSuite.FindSet() then
            repeat
                if (StrLen(ALTestSuite.Name) = 10) and (DelChr(CopyStr(ALTestSuite.Name, 3), '=', '0123456789') = '') then
                    exit(ALTestSuite.Name);
            until ALTestSuite.Next() = 0;
        exit('S-00000000');
    end;

    local procedure GetNextSuiteName(var LastSuiteName: Code[10]): Code[10]
    var
        ALTestSuite: Record "AL Test Suite";
    begin
        repeat
            if LastSuiteName = 'S-99999999' then
                Error(SuiteNumbersExhaustedErr);
            LastSuiteName := IncStr(LastSuiteName);
        until not ALTestSuite.Get(LastSuiteName);
        exit(LastSuiteName);
    end;

    local procedure AddConfiguration(ParentSuiteName: Code[10]; ConfigurationCode: Code[20]; Description: Text[100]; UseRandomSeed: Boolean; RandomSeed: Integer; WorkDateOffset: Text; OneByOne: Boolean; ReverseOrder: Boolean)
    var
        TestConfiguration: Record "Test Configuration";
    begin
        TestConfiguration.Init();
        TestConfiguration."Test Suite" := ParentSuiteName;
        TestConfiguration.Code := ConfigurationCode;
        TestConfiguration.Description := Description;
        TestConfiguration.Enabled := true;
        TestConfiguration."Use Random Seed" := UseRandomSeed;
        TestConfiguration."Random Seed" := RandomSeed;
        Evaluate(TestConfiguration."WorkDate Offset", WorkDateOffset);
        TestConfiguration."One By One" := OneByOne;
        TestConfiguration."Reverse Order" := ReverseOrder;
        TestConfiguration.Insert(true);
    end;
}
