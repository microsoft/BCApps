{
    "$schema": "./architecture-rules.schema.json",
    "version": 1,
    "rules": [
        {
            "id": "PA001",
            "check": "dependencies",
            "description": "The common version codeunit is used only by active-selection owners and approved version-query consumers.",
            "from": {"paths":["*"]},
            "to": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
            "exceptions": [
                {
                    "from": {"paths":["Entities/Setup/PASetup.Codeunit.al"]},
                    "reason": "Setup chooses its active-version storage."
                },
                {
                    "from": {"paths":["Flows/Configuration/PAAgentInstructions.Codeunit.al"]},
                    "reason": "Agent Instructions selects the version-specific runtime instructions resource."
                },
                {
                    "from": {"paths":["Entities/WorkItem/PAWorkItem.Codeunit.al"]},
                    "reason": "Work Item acquisition stores new work in the active version."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/Flows/Intake/PADraftBasedSubscribers.Codeunit.al"]},
                    "reason": "Draft import subscribers must not handle v2 intake."
                },
                {
                    "from": {"paths":["Shared/Telemetry/PATelemetry.Codeunit.al"]},
                    "reason": "This consumer serializes or dispatches on the version of an existing work item."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "reason": "This consumer serializes or dispatches on the version of an existing work item."
                }
            ]
        },
        {
            "id": "PA002",
            "check": "dependencies",
            "description": "Development settings storage is accessed only through its development API.",
            "from": {"paths":["*"]},
            "to": {"paths":["_Development/PADevelopmentSettings.Table.al"]},
            "exceptions": [
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Codeunit.al"]},
                    "reason": "The development settings API owns this storage."
                },
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Page.al"]},
                    "reason": "The development-only settings editor is bound to its table."
                }
            ]
        },
        {
            "id": "PA003",
            "check": "namespaces",
            "description": "E-Document namespaces are confined to draft compatibility, historical setup schema and declarative administration.",
            "from": {"paths":["*"]},
            "namespaces": ["Microsoft.eServices.EDocument","Microsoft.EServices.EDocumentConnector.Microsoft365"],
            "exceptions": [
                {
                    "from": {"paths":["Compatibility/DraftBased/*"]},
                    "reason": "Irreducibly draft-specific integrations and declarative surfaces live here."
                },
                {
                    "from": {"paths":["_Obsolete/AgentTaskList.PageExt.al"]},
                    "target": "Microsoft.eServices.EDocument",
                    "reason": "The wholly obsolete upload pageextension retains its frozen V1 E-Document integration until CLEAN30."
                },
                {
                    "from": {"paths":["Entities/Setup/PayablesAgentSetup.Table.al"]},
                    "target": "Microsoft.eServices.EDocument",
                    "reason": "Historical table 3303 field 2 retains its obsolete E-Document Service relation until CLEANSCHEMA33; no runtime access to it is permitted."
                },
                {
                    "from": {"paths":["Shared/Security/PayablesAgAdm.Permissionset.al"]},
                    "target": "Microsoft.EServices.EDocumentConnector.Microsoft365",
                    "reason": "The administrator permission set declares the historical M365 connector grant; it is not runtime access."
                }
            ]
        },
        {
            "id": "PA004",
            "check": "dependencies",
            "description": "Table references belong to their owners; temporary and declarative references need explicit exceptions.",
            "from": {"paths":["*"]},
            "to": {"paths":["Entities/WorkItem/PayablesAgentWorkItem.Table.al","Entities/Setup/PayablesAgentSetup.Table.al"]},
            "exceptions": [
                {
                    "from": {"paths":["Entities/WorkItem/PAWorkItem.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "The Work Item entity owns its V2 table."
                },
                {
                    "from": {"paths":["Entities/WorkItem/PAWorkItemCollection.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "Collection owns set-oriented reads of V2 receipts."
                },
                {
                    "from": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "The common version codeunit resolves the stored version of a work item; PA024 restricts calls to that query."
                },
                {
                    "from": {"paths":["Flows/Execution/Supporting/PAWorkItemPosting.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "Posting deliberately replaces matching v2 outcome references as one set-level operation."
                },
                {
                    "from": {"paths":["Entities/Setup/*"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Setup owns its stored records."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "The app-owned test cleanup facade deletes V2 work item data while hiding its representation from test apps."
                },
                {
                    "from": {"paths":["Flows/Upgrade/PayablesAgentUpgrade.Codeunit.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Historical setup migrations must operate on the persisted old schema."
                },
                {
                    "from": {"paths":["Flows/Registration/PayablesAgentMetadata.Codeunit.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Registration supplies the table ID to data classification; it does not load a stored record."
                },
                {
                    "from": {"paths":["Flows/Registration/PayablesAgentMetadata.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "Registration supplies the task table ID to data classification; it does not load a stored record."
                },
                {
                    "from": {"paths":["Flows/Configuration/PayablesAgentSetup.Page.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "The setup page edits an explicitly temporary projection; PA021 pins that property."
                },
                {
                    "from": {"paths":["Flows/Supervision/PAAccPayablesAdministratorRC.PageExt.al","Flows/Supervision/PABusinessManagerRC.PageExt.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Role-center visibility reads the setup row; retain as an explicit cleanup exception."
                },
                {
                    "from": {"paths":["Shared/Security/PayablesAgAdm.Permissionset.al","Shared/Security/PayablesAgRead.Permissionset.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Human permission sets grant declarative setup access; this matcher does not distinguish permissions from runtime references."
                },
                {
                    "from": {"paths":["_Obsolete/PAMLLMSetup.Page.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "The frozen pre-CLEAN29 MLLM rollout page remains bound to its historical setup schema; placement forbids new obsolete objects."
                },
                {
                    "from": {"paths":["Flows/Execution/Supporting/PAWorkItemOutcome.Codeunit.al"]},
                    "target": "Entities/WorkItem/PayablesAgentWorkItem.Table.al",
                    "reason": "The isolated runtime PDF-attachment bridge retains the old entry-number file-name scheme for attachment idempotency; normal outcome persistence stays in Work Item."
                },
                {
                    "from": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "The temporary production V2 preview selector reads its opt-in from the setup row."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Production evaluations set and clear the temporary V2 preview opt-in through the semantic fixture API."
                },
                {
                    "from": {"paths":["_Obsolete/PAV2PreviewSetup.Page.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "The unsearchable temporary preview page is the only UI for the V2 preview opt-in."
                }
            ]
        },
        {
            "id": "PA005",
            "check": "dependencies",
            "description": "Entities must use concrete storage adapters instead of application flows, registration, UI or draft service orchestration.",
            "from": {"paths":["Entities/*"]},
            "to": {"paths":["Flows/*","Compatibility/DraftBased/*"]},
            "exceptions": [
                {
                    "from": {"paths":["Entities/WorkItem/PAWorkItem.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/WorkItem/PADraftBasedWorkItem.Codeunit.al",
                    "reason": "Work Item delegates V1 storage and correlation to its concrete compatibility adapter."
                },
                {
                    "from": {"paths":["Entities/Setup/PASetup.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Setup/PADraftBasedSetupStore.Codeunit.al",
                    "reason": "Setup delegates its V1 editable proposal and service synchronization to the concrete draft-based Setup Store."
                }
            ]
        },
        {
            "id": "PA006",
            "check": "dependencies",
            "description": "Framework task construction belongs to the authoritative Work Item Intake orchestration.",
            "from": {"paths":["*"]},
            "symbols": [
                {
                    "kind": "codeunit",
                    "name": "Agent Task Builder"
                },
                {
                    "kind": "codeunit",
                    "name": "Agent Task Message Builder"
                }
            ],
            "exceptions": [
                {
                    "from": {"paths":["Flows/Intake/PAWorkItemIntake.Codeunit.al"]},
                    "reason": "Task Intake is the single app-owned entry point for runtime task construction."
                }
            ]
        },
        {
            "id": "PA007",
            "check": "dependencies",
            "description": "Shared objects must call designated concrete draft entry points instead of depending freely on compatibility internals.",
            "from": {"paths":["*"]},
            "to": {"paths":["Compatibility/DraftBased/*"]},
            "exceptions": [
                {
                    "from": {"paths":["Compatibility/DraftBased/*"]},
                    "reason": "Draft implementation objects may collaborate within the compatibility boundary."
                },
                {
                    "from": {"paths":["Flows/Configuration/PayablesAgentSetup.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/PADraftBasedSetup.Codeunit.al",
                    "reason": "The setup page deliberately delegates the guarded v1-only additional-fields dialog."
                },
                {
                    "from": {"paths":["Entities/WorkItem/PAWorkItem.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/WorkItem/PADraftBasedWorkItem.Codeunit.al",
                    "reason": "Work Item delegates V1 storage and correlation to its concrete compatibility adapter."
                },
                {
                    "from": {"paths":["Flows/Intake/PAWorkItemIntake.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Flows/Intake/PADraftWorkItemIntake.Codeunit.al",
                    "reason": "Work Item Intake invokes the V1 import orchestration entry point after receipt creation."
                },
                {
                    "from": {"paths":["Flows/Upgrade/PayablesAgentUpgrade.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/PADraftBasedSetup.Codeunit.al",
                    "reason": "The one-time migration delegates creation of the draft-based credit memo service type to its owner."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/TestSupport/PADraftBasedTestFixtures.Codeunit.al",
                    "reason": "The semantic fixture facade delegates draft-specific source construction, setup and scripted user actions to its compatibility fixture."
                },
                {
                    "from": {"paths":["Entities/Setup/PASetup.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Setup/PADraftBasedSetupStore.Codeunit.al",
                    "reason": "Setup delegates its V1 editable proposal and service synchronization to the concrete draft-based Setup Store."
                },
                {
                    "from": {"paths":["Flows/Execution/Supporting/PAWorkItemPosting.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/WorkItem/PADraftBasedWorkItem.Codeunit.al",
                    "reason": "Posting delegates only the AGENT-service V1 set-level outcome replacement; the flow retains transaction ownership and the V2 set-write exception."
                },
                {
                    "from": {"paths":["Capabilities/Feedback/PayablesAgentOCV.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Capabilities/Feedback/PADraftBasedFeedback.Codeunit.al",
                    "reason": "Shared feedback delegates the historical draft-page context discriminator while retaining feedback handling ownership."
                },
                {
                    "from": {"paths":["Flows/Configuration/PADemoGuide.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The demo wizard invokes the concrete draft sample download and email entry point; no shared E-Document types are exposed."
                },
                {
                    "from": {"paths":["Flows/Configuration/PASetupUpdate.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The configuration flow delegates sending draft demo invoices after setup is applied."
                },
                {
                    "from": {"paths":["Flows/Configuration/PayablesAgentSetup.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The setup page delegates the draft demo-account detection and configuration entry point."
                },
                {
                    "from": {"paths":["_Obsolete/PADemoFilesToDownload.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The frozen obsolete download page retains its historical concrete demo-file download entry point until removal."
                },
                {
                    "from": {"paths":["_Obsolete/AgentTaskList.PageExt.al"]},
                    "target": "Compatibility/DraftBased/Entities/Setup/PADraftBasedSetupStore.Codeunit.al",
                    "reason": "The frozen obsolete V1 upload action still resolves the legacy AGENT service through the draft-based Setup Store."
                },
                {
                    "from": {"paths":["_Obsolete/PABillingLog.Table.al"]},
                    "target": "Compatibility/DraftBased/Capabilities/Billing/PABillingOperation.Enum.al",
                    "reason": "The frozen obsolete billing log retains the persisted operation enum identity; this is historical schema, not runtime billing orchestration."
                },
                {
                    "from": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/WorkItem/PADraftBasedWorkItem.Codeunit.al",
                    "reason": "The common version codeunit resolves the stored version of a work item; PA024 restricts calls to that query."
                }
            ]
        },
        {
            "id": "PA008",
            "check": "dependencies",
            "description": "Capabilities and shared mechanisms must not depend on flow implementations.",
            "from": {"paths":["Capabilities/*","Shared/*"],"kinds":["codeunit","table"]},
            "to": {"paths":["Flows/*"]}
        },
        {
            "id": "PA009",
            "check": "dependencies",
            "description": "Production objects must not consume test fixtures.",
            "from": {"paths":["*"]},
            "to": {"paths":["TestSupport/*","Compatibility/DraftBased/TestSupport/*"]},
            "exceptions": [
                {
                    "from": {"paths":["TestSupport/*"]},
                    "reason": "The semantic fixture facade delegates to version-specific fixture implementations."
                }
            ]
        },
        {
            "id": "PA010",
            "check": "properties",
            "description": "Implementation objects are internal; assignable permission sets remain public.",
            "from": {"paths":["*"],"kinds":["codeunit","table","enum","query","report","xmlport","interface"]},
            "properties": {
                "Access": "Internal"
            }
        },
        {
            "id": "PA011",
            "check": "properties",
            "description": "The app does not expose traditional AL extensibility.",
            "from": {"paths":["*"],"kinds":["page","table","enum"]},
            "properties": {
                "Extensible": false
            },
            "exceptions": [
                {
                    "from": {"paths":["_Obsolete/PABillingLog.Table.al","_Obsolete/PABillingOverview.Page.al","_Obsolete/PABillingTaskSetup.Table.al","_Obsolete/PADemoFile.Table.al","_Obsolete/PADemoFilesToDownload.Page.al"]},
                    "target": "Extensible",
                    "reason": "Retain historical obsolete surfaces unchanged; the placement rule freezes the allowed obsolete files."
                }
            ]
        },
        {
            "id": "PA012",
            "check": "forbiddenCode",
            "description": "Entity wrappers do not explicitly commit.",
            "from": {"paths":["Entities/*"]},
            "pattern": "(?<![\\w.])(?:Database\\s*\\.\\s*)?Commit\\s*\\("
        },
        {
            "id": "PA013",
            "check": "forbiddenCode",
            "description": "Entities do not own interactive UI.",
            "from": {"paths":["Entities/*"]},
            "pattern": "(?<![\\w.])(?:Message|Confirm|StrMenu)\\s*\\(|(?<![\\w.])Page\\b"
        },
        {
            "id": "PA014",
            "check": "dependencies",
            "description": "Entities do not depend on app-owned pages.",
            "from": {"paths":["Entities/*"]},
            "to": {"paths":["*"],"kinds":["page"]}
        },
        {
            "id": "PA015",
            "check": "forbiddenCode",
            "description": "Telemetry emission belongs to telemetry owners.",
            "from": {"paths":["*"]},
            "pattern": "\\b(?:Session|Telemetry)\\s*\\.\\s*LogMessage\\s*\\(",
            "exceptions": [
                {
                    "from": {"paths":["Shared/Telemetry/PATelemetry.Codeunit.al"]},
                    "reason": "Shared telemetry owns product and operational event emission."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/Shared/Telemetry/PADraftBasedTelemetry.Codeunit.al"]},
                    "reason": "Draft-specific telemetry owns V1 billing and demo events."
                }
            ]
        },
        {
            "id": "PA016",
            "check": "developmentOnly",
            "description": "Development objects must not exist in production compilation.",
            "from": {"paths":["_Development/*"]},
            "symbol": "DEVELOPMENT"
        },
        {
            "id": "PA017",
            "check": "manifest",
            "description": "The production manifest must not enable DEVELOPMENT.",
            "from": {"paths":["app.json"]},
            "forbiddenSymbols": ["DEVELOPMENT"]
        },
        {
            "id": "PA018",
            "check": "manifest",
            "description": "Only the approved test apps may access internals; production must not depend on test libraries.",
            "from": {"paths":["app.json"]},
            "allowedFriends": ["967eceac-106e-4102-b76a-fe5dc3d799e5","d1345542-62ab-433d-90f2-28137534572a"],
            "forbiddenDependencies": [
                "Tests-*",
                "Library *",
                "AI Development Toolkit - Evaluation",
                "AI Evaluate Tool",
                "5d86850b-0d76-4eca-bd7b-951ad998e997",
                "5095f467-0a01-4b99-99d1-9ff1237d286f",
                "517f890c-b49f-47de-8120-d0327974b89d",
                "4f820121-b9a0-4b0a-ade8-a4fc5ee2fde1"
            ]
        },
        {
            "id": "PA019",
            "check": "placement",
            "description": "Objects belong to documented owners and the app namespace; obsolete files are frozen.",
            "from": {"paths":["*"]},
            "namespace": "Microsoft.Agent.PayablesAgent",
            "allowedPaths": [
                "Flows/Registration/*",
                "Flows/Configuration/*",
                "Flows/Intake/*",
                "Flows/Execution/*",
                "Flows/Supervision/*",
                "Flows/Upgrade/*",
                "Entities/Setup/*",
                "Entities/WorkItem/*",
                "Entities/KnownSender/*",
                "Entities/KPI/*",
                "Entities/Trial/*",
                "Capabilities/Trial/*",
                "Capabilities/KPI/*",
                "Capabilities/Feedback/*",
                "Capabilities/KnownSenders/*",
                "Shared/Telemetry/*",
                "Shared/Outcomes/*",
                "Shared/Security/*",
                "Shared/Versioning/*",
                "Compatibility/DraftBased/*",
                "Operations/EmailStorageCleanup/*",
                "TestSupport/*",
                "_Development/*",
                "_Obsolete/PABillingLog.Table.al",
                "_Obsolete/PABillingOverview.Page.al",
                "_Obsolete/PABillingTaskSetup.Table.al",
                "_Obsolete/PADemoFile.Table.al",
                "_Obsolete/PADemoFilesToDownload.Page.al",
                "_Obsolete/PAMLLMSetup.Page.al",
                "_Obsolete/AgentTaskList.PageExt.al",
                "_Obsolete/PAV2PreviewSetup.Page.al"
            ]
        },
        {
            "id": "PA020",
            "check": "properties",
            "description": "Work item list rows and stateless outcome facts remain temporary projections.",
            "from": {"paths":["Flows/Supervision/PAWorkItemListRow.Table.al","Shared/Outcomes/PAPurchaseOutcomeFacts.Table.al"]},
            "properties": {
                "TableType": "Temporary"
            }
        },
        {
            "id": "PA021",
            "check": "properties",
            "description": "Projection pages must not edit stored records directly.",
            "from": {"paths":["Flows/Supervision/PayablesAgentWorkItems.Page.al","Flows/Supervision/PAEmailReview.Page.al","Flows/Configuration/PayablesAgentSetup.Page.al"]},
            "properties": {
                "SourceTableTemporary": true
            }
        },
        {
            "id": "PA023",
            "check": "dependencies",
            "description": "Development API objects are usable only by the exact selector, agent-view simulation and semantic fixture seams or the development editor.",
            "from": {"paths":["*"]},
            "to": {"paths":["_Development/*"],"kinds":["codeunit","page"]},
            "exceptions": [
                {
                    "from": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The existing DEVELOPMENT selector reads the explicit evaluation override and V2 switch."
                },
                {
                    "from": {"paths":["Shared/Security/PAAgentAccess.Codeunit.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The DEVELOPMENT agent-view seam reads the simulated agent task so UI scoping matches a real agent session; runtime-only queries ignore it."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The app-owned semantic fixture API prepares and reads the DEVELOPMENT evaluation-version override."
                },
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Page.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The DEVELOPMENT-only editor loads settings and clears the evaluation override through its owner API."
                }
            ]
        },
        {
            "id": "PA024",
            "check": "forbiddenCode",
            "description": "Only telemetry and semantic fixtures may call GetVersion on the common version codeunit; IsV2Active keeps its separate owner access.",
            "from": {"paths":["*"]},
            "exceptions": [
                {
                    "from": {"paths":["Shared/Telemetry/PATelemetry.Codeunit.al"]},
                    "reason": "Telemetry serializes the existing version dimension."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "reason": "The semantic fixture facade owns version dispatch and diagnostic evidence."
                }
            ],
            "pattern": "\\.\\s*(?:GetVersion|\"GetVersion\")\\s*\\(",
            "includeQuotedIdentifiers": true
        },
        {
            "id": "PA025",
            "check": "forbiddenCode",
            "description": "The semantic Work Item API is an explicit one-line declaration contract; new or changed exported members require a conscious policy update, including version aliases.",
            "from": {"paths":["Entities/WorkItem/PAWorkItem.Codeunit.al"]},
            "pattern": "(?m)^[ \\t]*(?:internal[ \\t]+)?procedure[ \\t]+(?!(?:Load\\(WorkItemId:[ \\t]+Guid\\):[ \\t]+Boolean|LoadByAgentTaskId\\(AgentTaskId:[ \\t]+BigInteger\\):[ \\t]+Boolean|LoadCurrentSession\\(\\):[ \\t]+Boolean|Refresh\\(\\)|GetId\\(\\):[ \\t]+Guid|GetAdmissionStatus\\(\\):[ \\t]+Enum[ \\t]+\"PA[ \\t]+Work[ \\t]+Item[ \\t]+Admission[ \\t]+Status\"|IsAccepted\\(\\):[ \\t]+Boolean|HasAgentTask\\(\\):[ \\t]+Boolean|GetAgentTaskId\\(\\):[ \\t]+BigInteger|GetAgentTaskExternalId\\(\\):[ \\t]+Text\\[2048\\]|GetTitle\\(\\):[ \\t]+Text\\[150\\]|GetAgentTaskStatus\\(\\):[ \\t]+Enum[ \\t]+\"Agent[ \\t]+Task[ \\t]+Status\"|GetState\\(\\):[ \\t]+Enum[ \\t]+\"PA[ \\t]+Work[ \\t]+Item[ \\t]+State\"|GetRejectionReason\\(\\):[ \\t]+Text|GetSourceType\\(\\):[ \\t]+Enum[ \\t]+\"PA[ \\t]+Source[ \\t]+Type\"|GetFileName\\(\\):[ \\t]+Text|HasPdf\\(\\):[ \\t]+Boolean|GetSourcePdf\\(var[ \\t]+TempBlob:[ \\t]+Codeunit[ \\t]+\"Temp[ \\t]+Blob\";[ \\t]+var[ \\t]+FileName:[ \\t]+Text\\):[ \\t]+Boolean|GetEmailFrom\\(\\):[ \\t]+Text|GetSenderAddress\\(\\):[ \\t]+Text\\[250\\]|GetSenderName\\(\\):[ \\t]+Text|GetEmailSubject\\(\\):[ \\t]+Text|GetEmailExternalId\\(\\):[ \\t]+Text|GetEmailReceivedAt\\(\\):[ \\t]+DateTime|GetSourceEmailBody\\(\\):[ \\t]+Text|TryGetEmailHeader\\(HeaderName:[ \\t]+Text;[ \\t]+var[ \\t]+HeaderValue:[ \\t]+Text\\):[ \\t]+Boolean|GetCreatedAt\\(\\):[ \\t]+DateTime|GetUpdatedAt\\(\\):[ \\t]+DateTime|CanExtractText\\(\\):[ \\t]+Boolean|CanRegisterOutcome\\(\\):[ \\t]+Boolean|GetExtractedText\\(\\):[ \\t]+Text|GetOutcome\\(\\):[ \\t]+RecordId|IsResultRecord\\(Candidate:[ \\t]+RecordId\\):[ \\t]+Boolean|CreateFromPdf\\(FileName:[ \\t]+Text;[ \\t]+PdfInStream:[ \\t]+InStream\\):[ \\t]+Boolean|AssociateAgentTask\\(AgentTaskId:[ \\t]+BigInteger\\)|MarkRejected\\(Reason:[ \\t]+Text\\)|SetExtractedText\\(NewText:[ \\t]+Text\\)|RegisterOutcome\\(OutcomeId:[ \\t]+RecordId\\))[ \\t]*\\r?$)[^\\r\\n]+",
            "includeQuotedIdentifiers": true
        },
        {
            "id": "PA027",
