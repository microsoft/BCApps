{
    "$schema": "./architecture-rules.schema.json",
    "version": 3,
    "rules": [
        {
            "id": "PA001",
            "check": "dependencies",
            "description": "Keep active-version selection in the approved backing adapters and import guard.",
            "from": {"paths":["*"]},
            "to": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
            "exceptions": [
                {
                    "from": {"paths":["Entities/Setup/PASetup.Codeunit.al"]},
                    "reason": "Setup chooses its active-version backing representation."
                },
                {
                    "from": {"paths":["Flows/Configuration/PAAgentInstructions.Codeunit.al"]},
                    "reason": "Agent Instructions selects the version-specific runtime instructions resource."
                },
                {
                    "from": {"paths":["Entities/TaskSource/PATaskSource.Codeunit.al"]},
                    "reason": "Source acquisition chooses the configured version's backing representation."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/Flows/Intake/PADraftBasedSubscribers.Codeunit.al"]},
                    "reason": "Draft import subscribers must not handle v2 intake."
                }
            ]
        },
        {
            "id": "PA002",
            "check": "dependencies",
            "description": "Development settings storage is accessed only through its development API.",
            "from": {"paths":["*"]},
            "to": {"paths":["_Development/PADevelopmentSettings.Table.al"]},
            "exceptions": [
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Codeunit.al"]},
                    "reason": "The development settings API owns this storage."
                },
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Page.al"]},
                    "reason": "The development-only settings editor is bound to its backing table."
                }
            ]
        },
        {
            "id": "PA003",
            "check": "namespaces",
            "description": "E-Document namespaces are confined to draft compatibility, historical setup schema and declarative administration.",
            "from": {"paths":["*"]},
            "namespaces": ["Microsoft.eServices.EDocument","Microsoft.EServices.EDocumentConnector.Microsoft365"],
            "exceptions": [
                {
                    "from": {"paths":["Compatibility/DraftBased/*"]},
                    "reason": "Irreducibly draft-specific integrations and declarative surfaces live here."
                },
                {
                    "from": {"paths":["Entities/Setup/PayablesAgentSetup.Table.al"]},
                    "target": "Microsoft.eServices.EDocument",
                    "reason": "Historical table 3303 field 2 retains its obsolete E-Document Service relation until CLEANSCHEMA33; no runtime backing access is permitted."
                },
                {
                    "from": {"paths":["Shared/Security/PayablesAgAdm.Permissionset.al"]},
                    "target": "Microsoft.EServices.EDocumentConnector.Microsoft365",
                    "reason": "The administrator permission set declares the historical M365 connector grant; it is not runtime access."
                }
            ]
        },
        {
            "id": "PA004",
            "check": "dependencies",
            "description": "Backing table references belong to their owners; temporary and declarative references need explicit exceptions.",
            "from": {"paths":["*"]},
            "to": {"paths":["Entities/Task/PayablesAgentTask.Table.al","Entities/Setup/PayablesAgentSetup.Table.al"]},
            "exceptions": [
                {
                    "from": {"paths":["Entities/Task/*"]},
                    "target": "Entities/Task/PayablesAgentTask.Table.al",
                    "reason": "Task owns its backing records."
                },
                {
                    "from": {"paths":["Entities/TaskSource/*"]},
                    "target": "Entities/Task/PayablesAgentTask.Table.al",
                    "reason": "The source wrapper owns its v2 backing record."
                },
                {
                    "from": {"paths":["Flows/Execution/Supporting/PATaskPosting.Codeunit.al"]},
                    "target": "Entities/Task/PayablesAgentTask.Table.al",
                    "reason": "Posting deliberately replaces matching v2 outcome references as one set-level operation."
                },
                {
                    "from": {"paths":["Entities/Setup/*"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Setup owns its backing records."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "Entities/Task/PayablesAgentTask.Table.al",
                    "reason": "The app-owned test cleanup facade deletes v2 task backing data while hiding its representation from test apps."
                },
                {
                    "from": {"paths":["Flows/Upgrade/PayablesAgentUpgrade.Codeunit.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Historical setup migrations must operate on the persisted old schema."
                },
                {
                    "from": {"paths":["Flows/Registration/PayablesAgentMetadata.Codeunit.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Registration supplies the table ID to data classification; it does not load a backing record."
                },
                {
                    "from": {"paths":["Flows/Configuration/PayablesAgentSetup.Page.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "The setup page edits an explicitly temporary projection; PA021 pins that property."
                },
                {
                    "from": {
                        "paths": [
                            "Flows/Supervision/PAAccPayablesAdministratorRC.PageExt.al",
                            "Flows/Supervision/PABusinessManagerRC.PageExt.al"
                        ]
                    },
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Role-center visibility reads the setup row; retain as an explicit cleanup exception."
                },
                {
                    "from": {
                        "paths": ["Shared/Security/PayablesAgAdm.Permissionset.al","Shared/Security/PayablesAgRead.Permissionset.al"]
                    },
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "Human permission sets grant declarative setup access; this matcher does not distinguish permissions from runtime references."
                },
                {
                    "from": {"paths":["_Obsolete/PAMLLMSetup.Page.al"]},
                    "target": "Entities/Setup/PayablesAgentSetup.Table.al",
                    "reason": "The frozen pre-CLEAN29 MLLM rollout page remains bound to its historical setup schema; placement forbids new obsolete objects."
                }
            ]
        },
        {
            "id": "PA005",
            "check": "dependencies",
            "description": "Entities must use concrete backing adapters instead of application flows, registration, UI or draft service orchestration.",
            "from": {"paths":["Entities/*"]},
            "to": {"paths":["Flows/*","Compatibility/DraftBased/*"]},
            "exceptions": [
                {
                    "from": {"paths":["Entities/TaskSource/PATaskSource.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/TaskSource/PADraftBasedTaskSource.Codeunit.al",
                    "reason": "The logical source delegates its v1 backing representation to the compatibility entity adapter."
                },
                {
                    "from": {"paths":["Entities/Setup/PASetup.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Setup/PADraftBasedSetupBacking.Codeunit.al",
                    "reason": "Setup delegates its V1 editable proposal and service synchronization to the concrete draft backing owner."
                },
                {
                    "from": {"paths":["Entities/Task/PayablesAgentTask.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Task/PADraftBasedTask.Codeunit.al",
                    "reason": "Task delegates resolved V1 backing reads and lifecycle mapping to the concrete draft task adapter without rediscovering source identity."
                }
            ]
        },
        {
            "id": "PA006",
            "check": "dependencies",
            "description": "Runtime task construction belongs to the authoritative Task Intake flow.",
            "from": {"paths":["*"]},
            "symbols": [{"kind":"codeunit","name":"Agent Task Builder"},{"kind":"codeunit","name":"Agent Task Message Builder"}],
            "exceptions": [
                {
                    "from": {"paths":["Flows/Intake/PATaskIntake.Codeunit.al"]},
                    "reason": "Task Intake is the single app-owned entry point for runtime task construction."
                }
            ]
        },
        {
            "id": "PA007",
            "check": "dependencies",
            "description": "Shared objects must call designated concrete draft entry points instead of depending freely on compatibility internals.",
            "from": {"paths":["*"]},
            "to": {"paths":["Compatibility/DraftBased/*"]},
            "exceptions": [
                {
                    "from": {"paths":["Compatibility/DraftBased/*"]},
                    "reason": "Draft implementation objects may collaborate within the compatibility boundary."
                },
                {
                    "from": {"paths":["Flows/Configuration/PayablesAgentSetup.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/PADraftBasedSetup.Codeunit.al",
                    "reason": "The setup page deliberately delegates the guarded v1-only additional-fields dialog."
                },
                {
                    "from": {"paths":["Entities/TaskSource/PATaskSource.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/TaskSource/PADraftBasedTaskSource.Codeunit.al",
                    "reason": "The version-neutral source delegates v1 backing access through one compatibility entity adapter."
                },
                {
                    "from": {"paths":["Flows/Intake/PATaskIntake.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Flows/Intake/PADraftBasedSourceIntake.Codeunit.al",
                    "reason": "Authoritative task intake invokes the v1 import processing entry point after creating its source."
                },
                {
                    "from": {"paths":["Flows/Upgrade/PayablesAgentUpgrade.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/PADraftBasedSetup.Codeunit.al",
                    "reason": "The one-time migration delegates creation of the draft-based credit memo service type to its owner."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/TestSupport/PADraftBasedTestFixtures.Codeunit.al",
                    "reason": "The semantic fixture facade delegates draft-specific source construction, setup and scripted user actions to its compatibility fixture."
                },
                {
                    "from": {"paths":["Entities/Setup/PASetup.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Setup/PADraftBasedSetupBacking.Codeunit.al",
                    "reason": "Setup delegates its V1 editable proposal and service synchronization to the concrete draft backing owner."
                },
                {
                    "from": {"paths":["Entities/Task/PayablesAgentTask.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Task/PADraftBasedTask.Codeunit.al",
                    "reason": "Task delegates resolved V1 backing reads and lifecycle mapping to the concrete draft task adapter without rediscovering source identity."
                },
                {
                    "from": {"paths":["Flows/Execution/Supporting/PATaskPosting.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Entities/Task/PADraftBasedTask.Codeunit.al",
                    "reason": "Posting delegates only the AGENT-service V1 set-level outcome replacement; the flow retains transaction ownership and the V2 set-write exception."
                },
                {
                    "from": {"paths":["Capabilities/Feedback/PayablesAgentOCV.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Capabilities/Feedback/PADraftBasedFeedback.Codeunit.al",
                    "reason": "Shared feedback delegates the historical draft-page context discriminator while retaining feedback handling ownership."
                },
                {
                    "from": {"paths":["Flows/Configuration/PADemoGuide.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The demo wizard invokes the concrete draft sample download and email entry point; no shared E-Document types are exposed."
                },
                {
                    "from": {"paths":["Flows/Configuration/PASetupUpdate.Codeunit.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The configuration flow delegates sending draft demo invoices after setup is applied."
                },
                {
                    "from": {"paths":["Flows/Configuration/PayablesAgentSetup.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The setup page delegates the draft demo-account detection and configuration entry point."
                },
                {
                    "from": {"paths":["_Obsolete/PADemoFilesToDownload.Page.al"]},
                    "target": "Compatibility/DraftBased/Flows/Configuration/DemoGuide/PADemoGuide.Codeunit.al",
                    "reason": "The frozen obsolete download page retains its historical concrete demo-file download entry point until removal."
                },
                {
                    "from": {"paths":["_Obsolete/PABillingLog.Table.al"]},
                    "target": "Compatibility/DraftBased/Capabilities/Billing/PABillingOperation.Enum.al",
                    "reason": "The frozen obsolete billing log retains the persisted operation enum identity; this is historical schema, not runtime billing orchestration."
                }
            ]
        },
        {
            "id": "PA008",
            "check": "dependencies",
            "description": "Capabilities and shared mechanisms must not depend on flow implementations except designated runtime session identification.",
            "from": {"paths":["Capabilities/*","Shared/*"],"kinds":["codeunit","table"]},
            "to": {"paths":["Flows/*"]},
            "exceptions": [
                {
                    "from": {"paths":["Capabilities/KPI/PayablesAgentKPI.Codeunit.al"]},
                    "target": "Flows/Registration/PayablesAgentMetadata.Codeunit.al",
                    "reason": "The KPI purchase-invoice subscriber uses registration metadata only to identify the current Payables Agent runtime session before counting."
                }
            ]
        },
        {
            "id": "PA009",
            "check": "dependencies",
            "description": "Production objects must not consume test fixtures.",
            "from": {"paths":["*"]},
            "to": {"paths":["TestSupport/*","Compatibility/DraftBased/TestSupport/*"]},
            "exceptions": [
                {
                    "from": {"paths":["TestSupport/*"]},
                    "reason": "The semantic fixture facade delegates to backing-specific fixture implementations."
                }
            ]
        },
        {
            "id": "PA010",
            "check": "properties",
            "description": "Implementation objects are internal; assignable permission sets remain public.",
            "from": {"paths":["*"],"kinds":["codeunit","table","enum","query","report","xmlport","interface"]},
            "properties": {"Access":"Internal"}
        },
        {
            "id": "PA011",
            "check": "properties",
            "description": "The app does not expose traditional AL extensibility.",
            "from": {"paths":["*"],"kinds":["page","table","enum"]},
            "properties": {"Extensible":false},
            "exceptions": [
                {
                    "from": {
                        "paths": [
                            "_Obsolete/PABillingLog.Table.al",
                            "_Obsolete/PABillingOverview.Page.al",
                            "_Obsolete/PABillingTaskSetup.Table.al",
                            "_Obsolete/PADemoFile.Table.al",
                            "_Obsolete/PADemoFilesToDownload.Page.al"
                        ]
                    },
                    "target": "Extensible",
                    "reason": "Retain historical obsolete surfaces unchanged; the placement rule freezes the allowed obsolete files."
                }
            ]
        },
        {
            "id": "PA012",
            "check": "forbiddenCode",
            "description": "Entity wrappers do not explicitly commit.",
            "from": {"paths":["Entities/*"]},
            "pattern": "(?<![\\w.])(?:Database\\s*\\.\\s*)?Commit\\s*\\("
        },
        {
            "id": "PA013",
            "check": "forbiddenCode",
            "description": "Entities do not own interactive UI.",
            "from": {"paths":["Entities/*"]},
            "pattern": "(?<![\\w.])(?:Message|Confirm|StrMenu)\\s*\\(|(?<![\\w.])Page\\b"
        },
        {
            "id": "PA014",
            "check": "dependencies",
            "description": "Entities do not depend on app-owned pages.",
            "from": {"paths":["Entities/*"]},
            "to": {"paths":["*"],"kinds":["page"]}
        },
        {
            "id": "PA015",
            "check": "forbiddenCode",
            "description": "Telemetry emission belongs to telemetry owners.",
            "from": {"paths":["*"]},
            "pattern": "\\b(?:Session|Telemetry)\\s*\\.\\s*LogMessage\\s*\\(",
            "exceptions": [
                {
                    "from": {"paths":["Shared/Telemetry/PATelemetry.Codeunit.al"]},
                    "reason": "Shared telemetry owns product and operational event emission."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/Shared/Telemetry/PADraftBasedTelemetry.Codeunit.al"]},
                    "reason": "Draft-specific telemetry owns V1 billing and demo events."
                }
            ]
        },
        {
            "id": "PA016",
            "check": "developmentOnly",
            "description": "Development objects must not exist in production compilation.",
            "from": {"paths":["_Development/*"]},
            "symbol": "DEVELOPMENT"
        },
        {
            "id": "PA017",
            "check": "manifest",
            "description": "The production manifest must not enable DEVELOPMENT.",
            "from": {"paths":["app.json"]},
            "forbiddenSymbols": ["DEVELOPMENT"]
        },
        {
            "id": "PA018",
            "check": "manifest",
            "description": "Only the approved test apps may access internals; production must not depend on test libraries.",
            "from": {"paths":["app.json"]},
            "allowedFriends": ["967eceac-106e-4102-b76a-fe5dc3d799e5","d1345542-62ab-433d-90f2-28137534572a"],
            "forbiddenDependencies": [
                "Tests-*",
                "Library *",
                "AI Development Toolkit - Evaluation",
                "AI Evaluate Tool",
                "5d86850b-0d76-4eca-bd7b-951ad998e997",
                "5095f467-0a01-4b99-99d1-9ff1237d286f",
                "517f890c-b49f-47de-8120-d0327974b89d",
                "4f820121-b9a0-4b0a-ade8-a4fc5ee2fde1"
            ]
        },
        {
            "id": "PA019",
            "check": "placement",
            "description": "Objects belong to documented owners and the app namespace; obsolete files are frozen.",
            "from": {"paths":["*"]},
            "namespace": "Microsoft.Agent.PayablesAgent",
            "allowedPaths": [
                "Flows/Registration/*",
                "Flows/Configuration/*",
                "Flows/Intake/*",
                "Flows/Execution/*",
                "Flows/Supervision/*",
                "Flows/Upgrade/*",
                "Entities/Setup/*",
                "Entities/Task/*",
                "Entities/TaskSource/*",
                "Entities/KnownSender/*",
                "Entities/KPI/*",
                "Entities/Trial/*",
                "Capabilities/Trial/*",
                "Capabilities/KPI/*",
                "Capabilities/Feedback/*",
                "Capabilities/KnownSenders/*",
                "Shared/Telemetry/*",
                "Shared/Security/*",
                "Shared/Versioning/*",
                "Compatibility/DraftBased/*",
                "Operations/EmailStorageCleanup/*",
                "TestSupport/*",
                "_Development/*",
                "_Obsolete/PABillingLog.Table.al",
                "_Obsolete/PABillingOverview.Page.al",
                "_Obsolete/PABillingTaskSetup.Table.al",
                "_Obsolete/PADemoFile.Table.al",
                "_Obsolete/PADemoFilesToDownload.Page.al",
                "_Obsolete/PAMLLMSetup.Page.al"
            ]
        },
        {
            "id": "PA020",
            "check": "properties",
            "description": "Sortable task-list rows are temporary projections.",
            "from": {"paths":["Flows/Supervision/PADetailedTask.Table.al"]},
            "properties": {"TableType":"Temporary"}
        },
        {
            "id": "PA021",
            "check": "properties",
            "description": "Projection pages must not edit persisted backing records directly.",
            "from": {
                "paths": [
                    "Flows/Supervision/PayablesAgentTasks.Page.al",
                    "Flows/Supervision/PAEmailReview.Page.al",
                    "Flows/Configuration/PayablesAgentSetup.Page.al"
                ]
            },
            "properties": {"SourceTableTemporary":true}
        },
        {
            "id": "PA022",
            "check": "forbiddenCode",
            "description": "Explicit PA Version enum vocabulary belongs only to designated backing, intake, selector, compatibility and fixture owners.",
            "from": {"paths":["*"]},
            "pattern": "(?<![\\w.\"])Enum\\s+\"PA Version\"(?!\")|(?<!\")\"PA Version\"\\s*::",
            "includeQuotedIdentifiers": true,
            "exceptions": [
                {
                    "from": {"paths":["Entities/Task/PayablesAgentTask.Codeunit.al"]},
                    "target": "code",
                    "reason": "Task owns loaded-version identity, backing dispatch and supported operations."
                },
                {
                    "from": {"paths":["Entities/TaskSource/PATaskSource.Codeunit.al"]},
                    "target": "code",
                    "reason": "Source owns acquisition and loaded-version identity across V1 and V2 backing representations."
                },
                {
                    "from": {"paths":["Flows/Intake/PATaskIntake.Codeunit.al"]},
                    "target": "code",
                    "reason": "Authoritative intake dispatches received sources to V1 import or V2 task construction."
                },
                {
                    "from": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
                    "target": "code",
                    "reason": "The existing selector owns active-version vocabulary; PA001 independently restricts its consumers."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/Capabilities/Billing/PABilling.Codeunit.al"]},
                    "target": "code",
                    "reason": "Draft billing verifies that the loaded logical task has V1 backing before charging draft usage."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/Flows/Execution/AgentWorkspace/PAOpenCurrentEDocument.Codeunit.al"]},
                    "target": "code",
                    "reason": "Draft navigation verifies that the loaded logical task has V1 backing before opening its E-Document."
                },
                {
                    "from": {"paths":["Compatibility/DraftBased/TestSupport/PADraftBasedTestFixtures.Codeunit.al"]},
                    "target": "code",
                    "reason": "The compatibility fixture verifies V1 backing before building draft diagnostics."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "code",
                    "reason": "The semantic fixture facade owns evaluation version dispatch and serializes task-version diagnostics."
                },
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Codeunit.al"]},
                    "target": "code",
                    "reason": "The development API owns the explicit evaluation-version override."
                },
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Table.al"]},
                    "target": "code",
                    "reason": "Development settings persist the explicit evaluation-version override using the shared enum."
                }
            ]
        },
        {
            "id": "PA023",
            "check": "dependencies",
            "description": "Development API objects are usable only by the exact selector, simulation and semantic fixture seams or the development editor.",
            "from": {"paths":["*"]},
            "to": {
                "paths":["_Development/*"],
                "kinds": [
                    "codeunit",
                    "page"
                ]
            },
            "exceptions": [
                {
                    "from": {"paths":["Shared/Versioning/PAV1V2Flag.Codeunit.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The existing DEVELOPMENT selector reads the explicit evaluation override and V2 switch."
                },
                {
                    "from": {"paths":["Flows/Execution/AgentWorkspace/PAAgentExperience.Codeunit.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The existing DEVELOPMENT simulation seam reads the agent-experience override without changing session identity."
                },
                {
                    "from": {"paths":["TestSupport/PATestFixtures.Codeunit.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The app-owned semantic fixture API prepares and reads the DEVELOPMENT evaluation-version override."
                },
                {
                    "from": {"paths":["_Development/PADevelopmentSettings.Page.al"]},
                    "target": "_Development/PADevelopmentSettings.Codeunit.al",
                    "reason": "The DEVELOPMENT-only editor loads settings and clears the evaluation override through its owner API."
                }
            ]
        }
    ]
}
